# Node
# development for local and production for others
NODE_ENV=development
DEBUG_MODE=true

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=chatterbox
POSTGRES_SCHEMA=public
POSTGRES_LOG=true
POSTGRES_SLOW_QUERY_LIMIT=1000
POSTGRES_SSL=false
POSTGRES_APPLICATION_NAME=nestjs-chat
POSTGRES_POOL_SIZE=10
# Timezone the API process used before the AddTimestamptzToChatDates migration.
# Only needed for that one-time backfill when the migration is run from a
# machine whose timezone differs from the API's historical timezone.
# Defaults to the machine timezone (Intl), then UTC.
# LEGACY_LOCAL_TIMEZONE=Asia/Tehran

# Logger
LOG_USE_FILE=false
LOG_FILE=logs/app.log
LOG_LEVEL=debug

# Http
PORT=3000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Websockets
WEBSOCKET_PORT=3000

# Auth
AUTH_ACCESS_PUBLIC_KEY_PATH=keys/access_public.key
AUTH_ACCESS_PRIVATE_KEY_PATH=keys/access_private.key
AUTH_REFRESH_PUBLIC_KEY_PATH=keys/refresh_public.key
AUTH_REFRESH_PRIVATE_KEY_PATH=keys/refresh_private.key
AUTH_INTEGRATION_PUBLIC_KEY_PATH=keys/access_public.key
AUTH_INTEGRATION_TOKEN_ISSUER=nestjs-chat
AUTH_INTEGRATION_TOKEN_AUDIENCE=nestjs-chat-integration

# Http-Client
PLATFORM_API_URL=http://localhost:5000/v0/integration/users
PLATFORM_API_KEY=a608b77185c4b9ab2f34cf9eb6f5dadddee47a4a7531d4231558de80676fa31b
